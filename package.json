{
  "name": "modelhub-vscode",
  "displayName": "ModelHub",
  "description": "AI model and API management hub for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:modelhub.main",
    "onCommand:modelhub.open"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modelhub",
          "title": "ModelHub",
          "icon": "media/modelhub.svg"
        }
      ]
    },
    "views": {
      "modelhub": [
        {
          "id": "modelhub.main",
          "name": "ModelHub"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "modelhub.main",
        "contents": "ModelHub is active.\nNo providers are registered yet.\n[Refresh](command:modelhub.refresh)"
      }
    ],
    "commands": [
      {
        "command": "modelhub.open",
        "title": "Open ModelHub",
        "category": "ModelHub"
      },
      {
        "command": "modelhub.refresh",
        "title": "Refresh",
        "category": "ModelHub",
        "icon": "$(refresh)"
      },
      {
        "command": "modelhub.addProvider",
        "title": "Add Provider",
        "category": "ModelHub",
        "icon": "$(add)"
      },
      {
        "command": "modelhub.removeProvider",
        "title": "Remove Provider",
        "category": "ModelHub"
      },
      {
        "command": "modelhub.showAbout",
        "title": "About ModelHub",
        "category": "ModelHub"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "modelhub.refresh",
          "when": "view == modelhub.main",
          "group": "navigation@1"
        },
        {
          "command": "modelhub.addProvider",
          "when": "view == modelhub.main",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "modelhub.removeProvider",
          "when": "view == modelhub.main && viewItem =~ /^modelhub\\.provider\\./",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ModelHub",
      "properties": {
        "modelhub.general.logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "description": "Minimum log level for the ModelHub output channel."
        },
        "modelhub.providers.enableAutoDiscovery": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future phase: automatic model discovery for providers."
        },
        "modelhub.agent.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future phase: enables the ModelHub agent runtime."
        },
        "modelhub.permissions.defaultLevel": {
          "type": "string",
          "enum": ["automatic", "ask", "deny"],
          "default": "ask",
          "description": "Default permission level applied by the permission/policy engine (independent of the selected AI model)."
        },
        "modelhub.memory.autoCapture": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future phase: automatic memory capture under ~/.modelhub/memory (local-only by default)."
        },
        "modelhub.backend.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Reserved for a future phase: URL of the shared ModelHub backend. Empty means fully local/offline."
        },
        "modelhub.terminal.allowExecution": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future phase: allows agent tool execution in the integrated terminal (goes through the permission engine)."
        },
        "modelhub.recovery.snapshotOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future phase: creates recovery snapshots before agent file modifications."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:core": "mocha --ui tdd out/core-tests/**/*.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
